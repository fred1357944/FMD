{
  "name": "fmd-sample-plugin",
  "version": "0.1.0",
  "description": "Sample plugin for FMD (Fred's Markdown)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": ["fmd", "markdown", "plugin"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "typescript": "^5.8.3"
  }
}
