# Maintainer: Hung Yi Lai <fred1357944@gmail.com>

pkgname=fmd
pkgver=0.1.0
pkgrel=1
pkgdesc="Fred's Markdown writing workspace"
arch=('x86_64')
url='https://github.com/fred1357944/FMD'
license=('MIT')
install='fmd.install'
depends=('qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/fmd "$pkgdir/usr/bin/fmd"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/fmd.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/fmd.svg"
  /usr/bin/install -Dm644 "$startdir/fmd.desktop" "$pkgdir/usr/share/applications/fmd.desktop"
}
